{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "strict": false,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": false,
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "paths": {
      "@application/*": ["src/application/*"],
      "@modules/*": ["src/modules/*"],
      "@foundation/*": ["src/foundation/*"]
    }
  }
}
