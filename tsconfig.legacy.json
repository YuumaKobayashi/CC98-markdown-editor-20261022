{
  "extends": "./tsconfig.base.json",
  "files": [
    "src/foundation/types/images.d.ts",
    "src/foundation/types/react-18-compat.d.ts",
    "src/foundation/types/styles.d.ts",
    "src/foundation/types/third.d.ts"
  ],
  "compilerOptions": {
    "target": "ES2015",
    "moduleResolution": "Node10",
    "jsx": "react",
    "lib": ["DOM", "ES2015"]
  },
  "include": [
    "*.ts",
    "*.tsx",
    "Pages/**/*.ts",
    "Pages/**/*.tsx"
  ],
  "exclude": ["src", "node_modules", "dist"]
}
