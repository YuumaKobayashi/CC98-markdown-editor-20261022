{
  "extends": "./tsconfig.base.json",
  "files": [
    "src/foundation/types/images.d.ts",
    "src/foundation/types/react-18-compat.d.ts",
    "src/foundation/types/third.d.ts"
  ],
  "compilerOptions": {
    "target": "ES2015",
    "moduleResolution": "Node10",
    "jsx": "react",
    "lib": ["DOM", "ES2015"]
  },
  "include": [
    "*.ts",
    "*.tsx",
    "@types/@cc98/**/*.ts",
    "Components/**/*.ts",
    "Components/**/*.tsx",
    "config/**/*.ts",
    "config/**/*.tsx",
    "IndexedDB/**/*.ts",
    "IndexedDB/**/*.tsx",
    "Match/**/*.ts",
    "Match/**/*.tsx",
    "Pages/**/*.ts",
    "Pages/**/*.tsx",
    "Props/**/*.ts",
    "Props/**/*.tsx",
    "States/**/*.ts",
    "States/**/*.tsx",
    "Ubb/**/*.ts",
    "Ubb/**/*.tsx",
    "Utility/**/*.ts",
    "Utility/**/*.tsx"
  ],
  "exclude": ["src", "node_modules", "dist"]
}
